---
import { withBase } from '../lib/paths';
import { getCollection } from 'astro:content';
import { provenResults } from '../data/portfolio';
import Icon from './Icon.astro';

const work = await getCollection('work');
const workSlugs = new Set(work.map((entry) => entry.id));

for (const item of provenResults) {
  if (item.slug !== null && !workSlugs.has(item.slug)) {
    throw new Error(`ProofStrip: work slug "${item.slug}" does not exist in src/content/work.`);
  }
}
---

<section class="proof-section container" id="proof" aria-label="직접 확인한 결과">
  <ul class="proof-strip">
    {
      provenResults.map((item) =>
        item.slug ? (
          <li class="proof-strip__item">
            <a class="proof-strip__link" href={withBase(`work/${item.slug}/`)}>
              <strong class="proof-strip__value">{item.value}</strong>
              <span class="proof-strip__label">{item.label}</span>
              <span class="proof-strip__note">{item.note}</span>
              <Icon name="arrow-up-right" />
            </a>
          </li>
        ) : (
          <li class="proof-strip__item">
            <strong class="proof-strip__value">{item.value}</strong>
            <span class="proof-strip__label">{item.label}</span>
            <span class="proof-strip__note">{item.note}</span>
          </li>
        ),
      )
    }
  </ul>
  <p class="proof-strip__note-line">모두 내부 검증환경이나 로컬에서 직접 측정한 값입니다. 고객 운영환경의 성과가 아닙니다.</p>
</section>
