---
import { skillGroups, workingPrinciples } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section class="evidence-section container" id="about-me" aria-labelledby="about-me-title">
  <div class="section-heading">
    <p class="section-heading__eyebrow">About</p>
    <h2 id="about-me-title">일하는 방식</h2>
  </div>

  <ol class="principles-list">
    {workingPrinciples.map((principle) => <li>{principle}</li>)}
  </ol>

  <details class="skills-panel">
    <summary>
      <span>
        <span class="practice-panel__eyebrow">Technical Range</span>
        <strong>기술 스택</strong>
      </span>
      <Icon name="plus" />
    </summary>
    <dl>
      {
        skillGroups.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.values}</dd>
          </div>
        ))
      }
    </dl>
  </details>

  <div class="contact-cta">
    <p>
      전체 경력은 <a
        class="text-link"
        href="https://www.notion.so/1b80804a660e807db256ce7bd60d981b"
        target="_blank"
        rel="noreferrer">경력기술서</a
      >에 시간순으로 정리해 두었습니다.
    </p>
    <div class="contact-cta__actions">
      <p class="contact-cta__address">junhee742@naver.com</p>
    </div>
  </div>
</section>
