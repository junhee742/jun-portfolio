---
const stages = [
  {
    period: '2023',
    title: '고객사 구축',
    description: '요구사항부터 고객 검증·배포까지',
  },
  {
    period: '2024',
    title: '사내 AI 도구',
    description: '아이디어 제안과 단독 개발',
  },
  {
    period: '2024–25',
    title: '기업용 제품 운영',
    description: '고객사별 배포·모니터링·장애 대응',
  },
  {
    period: '2026',
    title: 'AI 제품·품질',
    description: 'AI 백엔드와 검증 자동화',
  },
];
---

<section class="career-arc" aria-labelledby="career-arc-title">
  <div class="career-arc__heading">
    <p>Career Arc</p>
    <h3 id="career-arc-title">구축 경험에서 AI 제품과 품질 자동화로</h3>
  </div>
  <ol class="career-arc__stages">
    {
      stages.map((stage, index) => (
        <li class="career-arc__stage">
          <span class="career-arc__period">{stage.period}</span>
          <strong>{stage.title}</strong>
          <span>{stage.description}</span>
          {index < stages.length - 1 && (
            <i class="ph ph-arrow-right career-arc__arrow" aria-hidden="true"></i>
          )}
        </li>
      ))
    }
  </ol>
</section>
