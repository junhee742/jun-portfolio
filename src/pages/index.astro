---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectRow from '../components/ProjectRow.astro';
import CapabilityIndex from '../components/CapabilityIndex.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SupportingWork from '../components/SupportingWork.astro';
import EvidenceSection from '../components/EvidenceSection.astro';
import Footer from '../components/Footer.astro';

const work = (await getCollection('work', ({ data }) => data.publicSafe && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <section class="hero container" id="about" aria-labelledby="hero-title">
      <p class="hero__eyebrow">기업 고객용(B2B) 백엔드 개발자</p>
      <h1 id="hero-title">낯선 문제는 작은 기능부터 직접 만들며 풀고,<br />배운 것을 다음 제품과 역할로 이어 왔습니다.</h1>
      <p class="hero__summary">
        운영 업무에서 반복되던 불편을 도구로 만들면서, 더 나은 방법이 궁금하면 직접 구현해
        보는 방식이 제 일하는 습관이 됐습니다. 그 경험은 사내 AI 챗봇의 제안·개발과 AI 제품
        백엔드로 이어졌습니다. 선택 이유와 사용 방법은 동료가 이어서 판단할 수 있게 기록합니다.
      </p>
      <dl class="hero__facts" aria-label="경력 요약">
        <div>
          <dt>경력</dt>
          <dd>2022.11–현재</dd>
        </div>
        <div>
          <dt>현재</dt>
          <dd>서로 다른 상담 제품이 함께 동작할 조건 검증</dd>
        </div>
        <div>
          <dt>역할 변화</dt>
          <dd>고객사 구축·운영 → 사내 AI 도구 → AI 제품 백엔드·품질 자동화</dd>
        </div>
      </dl>
      <div class="hero__actions">
        <a class="button button--primary" href="#experience">경력 한눈에 보기</a>
        <a class="text-link" href="#selected-work">
          대표 사례 보기
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <ExperienceSection />
    <CapabilityIndex />

    <section class="work-section container" id="selected-work" aria-labelledby="work-title">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-heading__eyebrow">Case Studies</p>
          <h2 id="work-title">대표 프로젝트</h2>
        </div>
        <p>
          앞에서 소개한 문제를 실제로 어떻게 풀었는지 보여주는 사례입니다. 제가 내린 판단,
          직접 맡은 범위와 확인 결과가 남아 있는 프로젝트만 골랐습니다.
        </p>
      </div>
      <div class="project-list">
        {work.map(({ id, data }) => (
          <ProjectRow
            id={id}
            order={data.order}
            title={data.homeTitle}
            summary={data.summary}
            period={data.period}
            product={data.product}
            role={data.role}
            evidence={data.evidence}
          />
        ))}
      </div>
    </section>

    <SupportingWork />
    <EvidenceSection />
  </main>
  <Footer />
</BaseLayout>
