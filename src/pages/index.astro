---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CareerTracks from '../components/CareerTracks.astro';
import EvidenceSection from '../components/EvidenceSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <section class="hero container" id="about" aria-labelledby="hero-title">
      <p class="hero__eyebrow">기업 고객용(B2B) 백엔드 개발자</p>
      <h1 id="hero-title">구축과 운영, AI 제품까지 넓게 맡았습니다.<br />AI는 사내 챗봇부터 직접 만들었습니다.</h1>
      <p class="hero__summary">
        2022년부터 B2B 상담 솔루션 회사에서 금융권 구축과 클라우드 고객사 운영을 맡았습니다.
        이후 AI 전담 조직에서 Agent·RAG와 품질 자동화를 개발했고, 앞으로도 고객과 문제를 정의하고
        구현과 운영까지 맡는 AI 제품 개발을 하려 합니다.
      </p>
      <p class="hero__meta">(주)스펙트라 제품개발부 · 2022.11 — 현재 · 4년 차</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#work">대표 사례 보기</a>
        <a class="text-link" href="mailto:junhee742@naver.com">
          이메일 보내기
          <Icon name="arrow-right" />
        </a>
      </div>
    </section>

    <ProofStrip />
    <CareerTracks />
    <EvidenceSection />
  </main>
  <Footer />
</BaseLayout>
